      "name": "createuser",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var random=Math.random().toString(36).substring(2);\r",
              "var useremailid=\"jim\"+random+\"@gmail.com\";\r",
              "console.log(useremailid);\r",
              "var username=\"jim\"+random;\r",
              "pm.environment.set(\"email_env\",useremailid);\r",
              "pm.environment.set(\"name_env\",username);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData=pm.response.json();\r",
              "pm.environment.set(\"id_env\",jsonData.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
